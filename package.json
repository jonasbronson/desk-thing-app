{
  "name": "desk-thing-app",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "author": "Jonas Bronson <contact@jonasbronson.com>",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "vue-tsc && vite build && electron-builder --linux deb --arm64 && electron-forge make",
    "make:arm64": "vue-tsc && vite build && electron-builder --linux deb --arm64 && electron-forge make --arch=arm64",
    "make:builder:arm64": "vue-tsc && vite build && electron-builder --linux deb --arm64",
    "make:forge:arm64": "vue-tsc && vite build && electron-forge make --arch=arm64",
    "app": "vue-tsc && vite build && electron-builder && electron-forge package && electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.5.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.26"
  },
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "config": {
            "name": "desk-thing-app",
            "authors": "Jonas Bronson",
            "description": "the ultimate desk companion"
          },
          "platforms": [
            "linux",
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "name": "desk-thing-app",
            "authors": "Jonas Bronson",
            "description": "the ultimate desk companion"
          },
          "platforms": [
            "linux"
          ]
        }
      ]
    }
  },
  "main": "dist-electron/main.js"
}
